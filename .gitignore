# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ Network Tools - .gitignore                                                ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ Collection of network diagnostic and utility tools                        ║
# ║ Stack: Python 3.x, C/C++, packet capture                                 ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Python Core ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# ─── Distribution & Packaging ────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Testing & Coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ─── Type Checking & Linting ─────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# ─── C/C++ Build Artifacts ───────────────────────────────────────────────────
*.o
*.a
*.so
*.dylib
*.exe
*.dll

# ─── Network Captures ────────────────────────────────────────────────────────
# Packet captures (can be large and contain sensitive data)
*.pcap
*.pcapng
*.cap
captures/
pcap_files/

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
.env.local

# Network credentials
*.credentials
network_passwords.txt

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
network_*.log

# ─── Temporary Files ─────────────────────────────────────────────────────────
*.tmp
*.temp
*~
*.swp
*.swo
